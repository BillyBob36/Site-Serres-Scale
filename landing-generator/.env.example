# ===========================================================================
#  landing-generator — variables d'environnement
#  Copiez ce fichier en `.env` puis renseignez VOS propres valeurs.
#  ⚠️ Ne committez JAMAIS le fichier rempli : `.env*` est gitignoré.
# ===========================================================================

# --- Base de données (SQLite via Prisma) -----------------------------------
# En local (sans Docker) : un fichier dans le projet suffit.
# En conteneur Docker : l'entrypoint force /home/data/landing.db (volume
# persistant) — la valeur ci-dessous n'est alors utilisée que hors conteneur.
DATABASE_URL="file:./dev.db"

# --- Fournisseur IA (OBLIGATOIRE pour la génération) ------------------------
# L'app appelle une API Azure OpenAI (compatible OpenAI).
# Fournissez VOTRE propre ressource : endpoint + clé + noms de déploiements.
# (Les noms de déploiement sont propres à VOTRE compte ; mettez les vôtres.)
AZURE_OPENAI_ENDPOINT="https://VOTRE-RESSOURCE.cognitiveservices.azure.com"
AZURE_OPENAI_KEY="votre-cle-azure-openai"
AZURE_OPENAI_DEPLOYMENT="nom-de-votre-deploiement-texte"
AZURE_IMAGE_DEPLOYMENT="nom-de-votre-deploiement-image"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# --- Authentification de l'espace admin (route /app-admin) ------------------
# AUTH_SECRET : chaîne aléatoire d'au moins 32 caractères.
#   Générer : `openssl rand -hex 32`
AUTH_SECRET="a-changer-32-caracteres-minimum-aleatoires"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="a-changer"
# Optionnel : durée de la session admin en jours (défaut : 7)
ADMIN_SESSION_DAYS="7"

# --- Divers (optionnel) -----------------------------------------------------
# URL de base pour des images statiques externes (laisser vide si non utilisé).
NEXT_PUBLIC_IMAGE_BASE_URL=""
# Port / interface d'écoute (défaut 3000 en conteneur).
# PORT="3000"
# HOSTNAME="0.0.0.0"

# ---------------------------------------------------------------------------
# Note Azure App Service : si le portail refuse les underscores dans les noms
# de réglages, le code lit aussi les variantes SANS underscore :
#   AUTHSECRET, ADMINUSERNAME, ADMINPASSWORD, ADMINSESSIONDAYS
# ---------------------------------------------------------------------------
